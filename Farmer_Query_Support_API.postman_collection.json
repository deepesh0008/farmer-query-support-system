    {
      "name": "Queries",
      "item": [
        {
          "name": "Create Query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalQuery\": \"My wheat plants have brown spots on leaves. What should I do?\",\n  \"queryType\": \"text\",\n  \"context\": {\n    \"cropType\": \"wheat\",\n    \"season\": \"rabi\",\n    \"symptomsDuration\": \"1-2 weeks\",\n    \"affectedAreaPercentage\": 30\n  },\n  \"media\": {}\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/queries",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "queries"]
            }
          }
        },
        {
          "name": "List Queries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/queries?page=1&limit=20&status=answered",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "queries"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "answered"
                }
              ]
            }
          }
        },
        {
          "name": "Get Query",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/queries/{{queryId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "queries", "{{queryId}}"]
            }
          }
        },
        {
          "name": "Add Feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
